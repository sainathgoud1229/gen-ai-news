# ============================================================
# GenAI & Agentic AI Daily Career Briefing — Environment Config
# ============================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
#
# NEVER commit your .env file to version control!
# ============================================================

# Google Gemini API Key
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail — Recipient email address
# The email address that will receive daily briefings
RECIPIENT_EMAIL=your_email@gmail.com

# Gmail — OAuth Credentials (from Google Cloud Console)
# Guide: https://docs.n8n.io/integrations/builtin/credentials/google/oauth-single-service/
GMAIL_CLIENT_ID=your_google_client_id_here
GMAIL_CLIENT_SECRET=your_google_client_secret_here

# n8n Configuration (self-hosted only)
# N8N_HOST=localhost
# N8N_PORT=5678
# N8N_PROTOCOL=http
